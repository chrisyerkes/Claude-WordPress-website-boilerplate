{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1170px",
			"wideSize": "1440px"
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"lightbox": {
			"enabled": true,
			"allowEditing": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true,
			"radiusSizes": [
				{ "slug": "button", "size": "4px", "name": "Button" },
				{ "slug": "card", "size": "8px", "name": "Card" },
				{ "slug": "pill", "size": "999px", "name": "Pill" }
			]
		},
		"dimensions": {
			"aspectRatio": true,
			"defaultAspectRatios": true,
			"dimensionSizes": [
				{ "slug": "narrow", "size": "20rem", "name": "Narrow" },
				{ "slug": "medium", "size": "34rem", "name": "Medium" },
				{ "slug": "wide", "size": "48rem", "name": "Wide" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "shadow": "0 1px 2px rgb(0 0 0 / 0.06), 0 2px 8px rgb(0 0 0 / 0.08)", "name": "Soft" },
				{ "slug": "raised", "shadow": "0 4px 12px rgb(0 0 0 / 0.10), 0 12px 28px rgb(0 0 0 / 0.10)", "name": "Raised" },
				{ "slug": "outlined", "shadow": "0 0 0 1px var(--wp--preset--color--light-gray)", "name": "Outlined" }
			]
		},
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"color": "#1a3a5c",
					"name": "Primary"
				},
				{
					"slug": "primary-dark",
					"color": "#0f2440",
					"name": "Primary Dark"
				},
				{
					"slug": "primary-light",
					"color": "#2d5a8e",
					"name": "Primary Light"
				},
				{
					"slug": "secondary",
					"color": "#c0392b",
					"name": "Secondary"
				},
				{
					"slug": "secondary-dark",
					"color": "#962d22",
					"name": "Secondary Dark"
				},
				{
					"slug": "tertiary",
					"color": "#e67e22",
					"name": "Tertiary"
				},
				{
					"slug": "white",
					"color": "#ffffff",
					"name": "White"
				},
				{
					"slug": "off-white",
					"color": "#f8f8f8",
					"name": "Off White"
				},
				{
					"slug": "light-gray",
					"color": "#e5e5e5",
					"name": "Light Gray"
				},
				{
					"slug": "medium-gray",
					"color": "#999999",
					"name": "Medium Gray"
				},
				{
					"slug": "dark-gray",
					"color": "#555555",
					"name": "Dark Gray"
				},
				{
					"slug": "near-black",
					"color": "#333333",
					"name": "Near Black"
				},
				{
					"slug": "black",
					"color": "#000000",
					"name": "Black"
				}
			]
		},
		"typography": {
			"dropCap": false,
			"fluid": true,
			"defaultFontSizes": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Sans",
					"slug": "system-sans"
				},
				{
					"fontFamily": "Georgia, 'Times New Roman', Times, serif",
					"name": "System Serif",
					"slug": "system-serif"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium",
					"fluid": false
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Large",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"size": "1.5rem",
					"name": "X-Large",
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "2rem",
					"name": "XX-Large",
					"fluid": {
						"min": "1.5rem",
						"max": "2rem"
					}
				},
				{
					"slug": "huge",
					"size": "2.5rem",
					"name": "Huge",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "gigantic",
					"size": "3.5rem",
					"name": "Gigantic",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "xs", "size": "0.5rem", "name": "XS" },
				{ "slug": "s", "size": "1rem", "name": "S" },
				{ "slug": "m", "size": "1.5rem", "name": "M" },
				{ "slug": "l", "size": "2.5rem", "name": "L" },
				{ "slug": "xl", "size": "4rem", "name": "XL" },
				{ "slug": "2-xl", "size": "6rem", "name": "2XL" },
				{ "slug": "3-xl", "size": "8rem", "name": "3XL" }
			],
			"units": [ "%", "px", "em", "rem", "vh", "vw" ]
		},
		"custom": {
			"borderRadius": {
				"button": "4px",
				"card": "8px",
				"pill": "999px"
			}
		},
		"blocks": {}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--near-black)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"right": "var(--wp--preset--spacing--s)",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--s)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-serif)",
					"fontWeight": "700",
					"lineHeight": "1.2"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--gigantic)"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"textTransform": "uppercase",
					"letterSpacing": "0.05em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"button": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-sans)",
					"fontSize": "var(--wp--preset--font-size--medium)",
					"fontWeight": "600"
				},
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "var(--wp--custom--border-radius--button)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--primary)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"select": {
				"border": {
					"color": "var(--wp--preset--color--light-gray)",
					"radius": "var(--wp--custom--border-radius--button)",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--white)",
					"text": "var(--wp--preset--color--near-black)"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"right": "0.75rem",
						"bottom": "0.5rem",
						"left": "0.75rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-sans)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"textInput": {
				"border": {
					"color": "var(--wp--preset--color--light-gray)",
					"radius": "var(--wp--custom--border-radius--button)",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--white)",
					"text": "var(--wp--preset--color--near-black)"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"right": "0.75rem",
						"bottom": "0.5rem",
						"left": "0.75rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-sans)",
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			}
		},
		"blocks": {
			"core/accordion": {
				"spacing": {
					"blockGap": "var(--wp--preset--spacing--xs)"
				}
			},
			"core/accordion-item": {
				"border": {
					"color": "var(--wp--preset--color--light-gray)",
					"radius": "var(--wp--custom--border-radius--card)",
					"style": "solid",
					"width": "1px"
				},
				"color": {
					"background": "var(--wp--preset--color--off-white)",
					"text": "var(--wp--preset--color--near-black)"
				},
				"spacing": {
					"blockGap": "0"
				}
			},
			"core/accordion-heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-sans)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.4"
				},
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--s)",
						"right": "var(--wp--preset--spacing--s)",
						"bottom": "var(--wp--preset--spacing--s)",
						"left": "var(--wp--preset--spacing--s)"
					}
				}
			},
			"core/accordion-panel": {
				"spacing": {
					"padding": {
						"top": "0",
						"right": "var(--wp--preset--spacing--s)",
						"bottom": "var(--wp--preset--spacing--s)",
						"left": "var(--wp--preset--spacing--s)"
					}
				}
			},
			"core/breadcrumbs": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--dark-gray)"
				}
			},
			"core/details": {
				"border": {
					"color": "var(--wp--preset--color--light-gray)",
					"radius": "var(--wp--custom--border-radius--card)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--s)",
						"right": "var(--wp--preset--spacing--s)",
						"bottom": "var(--wp--preset--spacing--s)",
						"left": "var(--wp--preset--spacing--s)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--light-gray)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)"
				}
			},
			"core/button": {
				"variations": {
					"outline": {
						"color": {
							"background": "transparent",
							"text": "var(--wp--preset--color--primary)"
						},
						"border": {
							"color": "var(--wp--preset--color--primary)",
							"radius": "var(--wp--custom--border-radius--button)",
							"style": "solid",
							"width": "2px"
						},
						":hover": {
							"color": {
								"background": "var(--wp--preset--color--primary)",
								"text": "var(--wp--preset--color--white)"
							}
						}
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	]
}
