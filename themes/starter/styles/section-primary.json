{
	"$schema": "https://schemas.wp.org/wp/7.0/theme.json",
	"version": 3,
	"title": "Primary Section",
	"slug": "section-primary",
	"blockTypes": [ "core/group", "core/columns", "core/cover" ],
	"styles": {
		"color": {
			"background": "var:preset|color|primary",
			"text": "var:preset|color|white"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|white"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|white"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|light-gray"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|white",
					"text": "var:preset|color|primary"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|off-white",
						"text": "var:preset|color|primary-dark"
					}
				}
			}
		}
	}
}
