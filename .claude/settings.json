{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",

	"model": "sonnet",
	"fallbackModel": [ "opus" ],
	"effortLevel": "medium",

	"permissions": {
		"defaultMode": "acceptEdits",

		"allow": [
			"Bash",
			"Read",
			"Edit",
			"Write",
			"Glob",
			"Grep",
			"WebFetch(domain:developer.wordpress.org)",
			"WebFetch(domain:make.wordpress.org)",
			"WebFetch(domain:wordpress.org)",
			"WebFetch(domain:schemas.wp.org)",
			"WebFetch(domain:www.advancedcustomfields.com)",
			"mcp__playwright",
			"mcp__plugin_playwright_playwright",
			"mcp__plugin_figma_figma",
			"mcp__plugin_chrome-devtools-mcp_chrome-devtools"
		],

		"ask": [
			"Bash(rm -rf *)",
			"Bash(rm -r *)",
			"Bash(wp db *)",
			"Bash(wp site *)",
			"Bash(wp user delete*)",
			"Bash(curl *)",
			"Bash(wget *)",
			"Bash(npm publish*)",
			"Bash(npm audit fix --force*)",
			"Bash(git push*)"
		],

		"deny": [
			"Bash(sudo *)",
			"Bash(rm -rf /)",
			"Bash(rm -rf /*)",
			"Bash(rm -rf ~*)",
			"Bash(git push --force*)",
			"Bash(git push -f*)",
			"Bash(git reset --hard*)",
			"Bash(git checkout -- *)",
			"Bash(git clean -f*)",
			"Bash(wp db drop*)",
			"Bash(wp db reset*)",
			"Bash(wp site empty*)",
			"Read(.env*)",
			"Read(**/.env*)",
			"Bash(cat *.env*)",
			"Bash(cat .env*)",
			"Bash(head *.env*)",
			"Bash(tail *.env*)",
			"Bash(less *.env*)",
			"Bash(more *.env*)",
			"Bash(grep * .env*)",
			"Bash(sed * .env*)",
			"Bash(awk * .env*)"
		]
	},

	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-generated-files.sh\""
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed-file.sh\""
					}
				]
			}
		]
	},

	"enableAllProjectMcpServers": true,

	"env": {
		"NODE_ENV": "development"
	},

	"includeGitInstructions": true,
	"respectGitignore": true
}
