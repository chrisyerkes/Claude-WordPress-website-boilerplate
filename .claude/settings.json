{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(npm run *)",
			"Bash(npm install *)",
			"Bash(npm update *)",
			"Bash(npm ls *)",
			"Bash(npm outdated *)",
			"Bash(npm audit *)",
			"Bash(node build/*)",
			"Bash(npx stylelint *)",
			"Bash(npx eslint *)",
			"Bash(git status *)",
			"Bash(git add *)",
			"Bash(git commit *)",
			"Bash(git log *)",
			"Bash(git diff *)",
			"Bash(git branch *)",
			"Bash(git checkout *)",
			"Bash(git stash *)",
			"Bash(git show *)",
			"Bash(git blame *)",
			"Bash(git remote *)",
			"Bash(ls *)",
			"Bash(find *)",
			"Bash(cat *)",
			"Bash(head *)",
			"Bash(tail *)",
			"Bash(wc *)",
			"Bash(grep *)",
			"Bash(rg *)",
			"Bash(mkdir *)",
			"Bash(cp *)",
			"Bash(mv *)",
			"Bash(rm themes/starter/assets/*)",
			"Bash(rm plugins/*/assets/*)",
			"Bash(touch *)",
			"Bash(php -l *)",
			"Bash(php -r *)",
			"Bash(which *)",
			"Bash(echo *)",
			"Bash(pwd)",
			"Bash(tree *)",
			"Bash(stat *)",
			"Bash(file *)",
			"Bash(diff *)",
			"Bash(sort *)",
			"Bash(uniq *)",
			"Bash(sed *)",
			"Bash(awk *)",
			"Bash(wp *)",
			"Read(*)",
			"Edit(*)",
			"Write(*)",
			"mcp__plugin_playwright_playwright__*",
			"mcp__plugin_figma_figma__*",
			"mcp__plugin_chrome-devtools-mcp_chrome-devtools__*"
		],
		"deny": [
			"Bash(git push --force *)",
			"Bash(git reset --hard *)",
			"Bash(rm -rf /)",
			"Bash(rm -rf /*)",
			"Read(.env*)"
		]
	},
	"env": {
		"NODE_ENV": "development"
	},
	"includeGitInstructions": true,
	"respectGitignore": true
}
